# Copy to .env — never commit a real .env. Without a key a feature turns
# itself off and says so; it never fakes a result.
PORT=8787
HOST=0.0.0.0
# Optional: Bearer token protecting POST /api/* (leave empty for local dev).
API_TOKEN=
# Claude Messages API — model id for askJson. Leave unset to use the
# heuristic fallback (the log says so on every job).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# YouTube Data API v3 key (Scout live metadata) and an OAuth access token
# with youtube.upload scope (real uploads, private by default).
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
# Comma-separated channel IDs you own. Only these count as "owned".
OWNED_CHANNEL_IDS=
# JSON file: [{channelId, evidence, attribution, expires}] — written
# permissions on file. Expired entries are treated as reference-only.
PERMISSIONS_FILE=
# Queue: in-process by default. Set QUEUE=bullmq + REDIS_URL to use BullMQ.
QUEUE=
REDIS_URL=
# Max approved uploads per day across all clips (approval gate).
DAILY_UPLOAD_CAP=10
# Max rendered clips per job (keeps render time sane on small machines).
MAX_CLIPS_PER_JOB=6
# Whisper model for faster-whisper (tiny is cached; small/base also cached).
WHISPER_MODEL=tiny
